# Скопируйте этот файл в `.env` и заполните реальными значениями.
# Никогда не коммитьте `.env`.

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# URL асинхронной базы данных SQLite.
DATABASE_URL=sqlite+aiosqlite:///./data/personal_manager.sqlite3

# Сколько секунд задача может находиться в статусе `running`, прежде чем
# считаться зависшей. Используется при восстановлении после запуска,
# чтобы пометить прерванные задачи как failed.
# JOB_STALE_TIMEOUT_SECONDS=3600

# Telegram Bot API. Оставьте токен пустым, чтобы работать без Telegram.
TELEGRAM_BOT_TOKEN=
# Чат, в который отправлять уведомления (оставьте пустым, чтобы отключить
# оповещения Telegram).
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=30

# Google Sheets (оставьте оба поля пустыми, чтобы отключить). Путь к
# JSON-файлу сервисного аккаунта и ID таблицы. Никогда не коммитьте сам
# JSON-файл.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=

# DeepSeek API (chat completions). Оставьте ключ пустым, чтобы отключить
# классификацию.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# Gmail (только чтение). Оставьте оба поля пустыми, чтобы отключить. Пути
# к JSON-файлам OAuth client secret и OAuth token. Никогда не коммитьте эти
# файлы.
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=
# Ограничение количества сообщений, импортируемых за один запуск.
GMAIL_MAX_MESSAGES=100

# --- Зарезервировано для будущих этапов (пока не используется) ---
# OPENROUTER_API_KEY=
